<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- JSON-ish single-line console logging, friendly to container log collectors. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Quiet noisy libraries -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.elasticsearch.client" level="WARN"/>
    <logger name="redis.clients" level="WARN"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
